# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Root domain that catalogue subdomains hang off. <slug>.ROOT_DOMAIN resolves a catalogue.
ROOT_DOMAIN=mehfil.localhost:3000

# ─── Data layer ───────────────────────────────────────────────────────────────
# memory   in-process, seeded from the demo fixture. Tests and `pnpm dev` with no Supabase.
# file     memory + JSON persistence under .data/. Useful for a laptop demo.
# supabase Postgres with RLS. Required in production.
DATA_DRIVER=file

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Video provider ───────────────────────────────────────────────────────────
# fake  deterministic local provider — no network, used by tests, CI and the offline demo
# bunny Bunny Stream
VIDEO_DRIVER=fake

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_WEBHOOK_SECRET=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars. Signs operator sessions and passcode cookies. Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# Seeded operator for local development only; ignored when DATA_DRIVER=supabase.
DEV_OPERATOR_EMAIL=operator@mehfil.test
DEV_OPERATOR_PASSWORD=mehfil-dev
